# Neon PostgreSQL connection string.
DATABASE_URL=
# Session cookie name and lifetime in days.
SESSION_COOKIE_NAME=atlas_session
SESSION_DURATION_DAYS=30
# Default: true in production, false in development. Keep true for public HTTPS.
# Set false only for local HTTP testing on a non-localhost address.
SESSION_SECURE=true
# AI provider: codex-subscription (default) or openai.
AI_PROVIDER=codex-subscription
AI_MODEL=gpt-6-luna
# Refreshed Codex subscription credentials file.
CODEX_AUTH_FILE=/run/codex/auth.json
# Required only when AI_PROVIDER=openai.
OPENAI_API_KEY=
# Maximum assistant replies per user in a rolling 24-hour window.
ATLAS_DAILY_REPLY_LIMIT=60

# Thinking level for replies: low | medium | high (safety + memory checks always use low)
# Public origin used in email links (HTTPS in production).
APP_BASE_URL=http://localhost:3000
# brevo | resend | postmark | console (console only in local development).
EMAIL_PROVIDER=brevo
EMAIL_FROM_NAME=Atlas Bodha
EMAIL_FROM_ADDRESS=atlas@managedbyai.dev
BREVO_API_KEY=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
# Enable only behind an ingress that OVERWRITES X-Forwarded-For.
# Otherwise requests share one conservative IP bucket.
TRUST_PROXY_IP=false
# Maximum new accounts per Pacific calendar day.
ATLAS_DAILY_SIGNUP_LIMIT=50
# Maximum assistant replies globally per Pacific calendar day.
ATLAS_GLOBAL_DAILY_REPLY_LIMIT=400
# Reply calls only: low | medium | high. Classifier/memory remain low.
AI_REASONING_EFFORT=medium
