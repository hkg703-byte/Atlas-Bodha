# Neon PostgreSQL connection string.
DATABASE_URL=
# Session cookie name and lifetime in days.
SESSION_COOKIE_NAME=atlas_session
SESSION_DURATION_DAYS=30
# Default: true in production, false in development. Keep true for public HTTPS.
# Set false only for local HTTP testing on a non-localhost address.
SESSION_SECURE=true
# AI provider: codex-subscription (default) or openai.
AI_PROVIDER=codex-subscription
AI_MODEL=gpt-6-luna
# Refreshed Codex subscription credentials file.
CODEX_AUTH_FILE=/run/codex/auth.json
# Required only when AI_PROVIDER=openai.
OPENAI_API_KEY=
# Maximum assistant replies per user in a rolling 24-hour window.
ATLAS_DAILY_REPLY_LIMIT=60

# Thinking level for replies: low | medium | high (safety + memory checks always use low)
AI_REASONING_EFFORT=medium
